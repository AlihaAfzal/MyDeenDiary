# ==========================================
# Root .gitignore for MyDeenDiary Monorepo
# ==========================================

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/schemas/

# ==========================================
# Backend API (Python / FastAPI)
# ==========================================
backend-api/venv/
backend-api/env/
backend-api/.venv/
backend-api/.env
backend-api/.env.*
backend-api/firebase-key.json
backend-api/__pycache__/
backend-api/*/__pycache__/
backend-api/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Frontend Mobile (Expo / React Native)
# ==========================================
frontend-mobile/node_modules/
frontend-mobile/.expo/
frontend-mobile/.env
frontend-mobile/.env*.local
frontend-mobile/dist/
frontend-mobile/web-build/
frontend-mobile/expo-env.d.ts
frontend-mobile/.kotlin/
frontend-mobile/*.orig.*
frontend-mobile/*.jks
frontend-mobile/*.p8
frontend-mobile/*.p12
frontend-mobile/*.key
frontend-mobile/*.mobileprovision
frontend-mobile/.metro-health-check*
frontend-mobile/npm-debug.*
frontend-mobile/yarn-debug.*
frontend-mobile/yarn-error.*
frontend-mobile/*.tsbuildinfo
frontend-mobile/ios/
frontend-mobile/android/

